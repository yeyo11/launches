---
import ArticlesPage from '../../../components/pages/ArticlesPage.astro';
import { indexViews, viewParam, type IndexView } from '../../../article-index';

export async function getStaticPaths() {
  return (await indexViews('es')).map((view) => ({ params: { path: viewParam('es', view) }, props: { view } }));
}

interface Props {
  view: IndexView;
}
---

<ArticlesPage lang="es" view={Astro.props.view} />

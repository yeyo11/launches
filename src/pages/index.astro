---
// Every page lives under a language and a static site cannot negotiate one, so the root sends
// readers to English, the default, at once; each page links to its Spanish version.
const target = `${import.meta.env.BASE_URL}en/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>José Antonio Garrido</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
  </head>
  <body>
    <a href={target}>English</a> · <a href={`${import.meta.env.BASE_URL}es/`}>Español</a>
  </body>
</html>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { STRINGS, formatDate, type Locale } from '../../site';
import { getPosts, projectName, slugOf, translationOf, urlOf, type Post } from '../../posts';

export async function getStaticPaths() {
  const all = await getPosts();
  return all.map((post) => ({
    params: { lang: post.data.lang, slug: slugOf(post) },
    props: { post, translation: translationOf(post, all) },
  }));
}

interface Props {
  post: Post;
  translation?: Post;
}

const { post, translation } = Astro.props;
const lang = post.data.lang as Locale;
const t = STRINGS[lang];
const { Content } = await render(post);
const alternate = translation && { lang: translation.data.lang as Locale, href: urlOf(translation) };
---

<Base lang={lang} title={post.data.title} description={post.data.description} alternate={alternate} type="article">
  <article class="wrap">
    <header>
      <p class="release ui">
        <a href={post.data.repo}>{projectName(post.data.repo)}</a>
        {post.data.version && <span>{post.data.version}</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="date muted">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back ui"><a href={`${import.meta.env.BASE_URL}${lang}/`}>{t.allLaunches}</a></p>
  </article>
</Base>

<style>
  header { padding-block: calc(var(--space) * 12) calc(var(--space) * 8); }
  .release {
    display: flex;
    align-items: baseline;
    gap: calc(var(--space) * 2);
    margin: 0;
    font-weight: 650;
  }
  .release a { color: var(--chalk); }
  .release span { font-family: var(--font-mono); font-variation-settings: 'MONO' 1; font-size: var(--fs-small); color: var(--dust); }
  h1 {
    font-size: clamp(var(--fs-h1), 8vw, var(--fs-title));
    font-weight: 850;
    line-height: 1.05;
    margin: calc(var(--space) * 4) 0 calc(var(--space) * 4);
  }
  .date { font-size: var(--fs-small); margin: 0; }
  .prose :global(h2) { font-size: var(--fs-h2); margin-block: 2.2em 0.6em; }
  .prose :global(h3) { font-size: var(--fs-h3); margin-block: 1.8em 0.4em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin-block: 0 1.1em; }
  .prose :global(li + li) { margin-block-start: 0.35em; }
  .prose :global(pre) { margin-block: 1.4em; }
  .prose :global(blockquote) { margin-inline: 0; padding-inline-start: 1em; border-inline-start: 3px solid var(--accent); color: var(--dust); }
  .prose :global(hr) { border: 0; border-block-start: 1px solid var(--rule); margin-block: 2.5em; }
  .back { margin-block-start: calc(var(--space) * 14); font-size: var(--fs-small); }
</style>

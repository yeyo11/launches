---
import '../styles/global.css';
import { SITE, STRINGS, type Locale } from '../site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** The same page in the other language, when it exists */
  alternate?: { lang: Locale; href: string };
  type?: 'website' | 'article';
  /** The index carries the title as its h1, so the header does not repeat it */
  home?: boolean;
}

const { lang, title, description, alternate, type = 'website', home = false } = Astro.props;
const t = STRINGS[lang];
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === t.title ? `${t.title}, ${SITE.author}` : `${title} | ${t.title}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={t.title} href={`${base}${lang}/rss.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#02142C" />
    <!-- Before the first paint, so a reader who chose day never sees a flash of night -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'day') document.documentElement.dataset.theme = 'day';
    </script>
  </head>
  <body>
    <header class="site wrap">
      {!home && <a class="home" href={`${base}${lang}/`}>{t.title}</a>}
      <nav>
        {alternate && <a href={alternate.href} hreflang={alternate.lang} lang={alternate.lang}>{t.readIn}</a>}
        <button type="button" class="theme" data-to-day={t.toDay} data-to-night={t.toNight}>{t.toDay}</button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site wrap muted">
      <span>{SITE.author}</span>
      {SITE.profiles.map(([name, href]) => <a href={href} rel="me">{name}</a>)}
      <a href={`${base}${lang}/rss.xml`}>RSS</a>
      {SITE.support && <a class="support" href={SITE.support}>{t.support}</a>}
    </footer>
  </body>
</html>

<script>
  const button = document.querySelector<HTMLButtonElement>('button.theme');
  const root = document.documentElement;
  const label = () => {
    if (!button) return;
    button.textContent = (root.dataset.theme === 'day' ? button.dataset.toNight : button.dataset.toDay) ?? '';
  };
  label();
  button?.addEventListener('click', () => {
    if (root.dataset.theme === 'day') {
      delete root.dataset.theme;
      localStorage.removeItem('theme');
    } else {
      root.dataset.theme = 'day';
      localStorage.setItem('theme', 'day');
    }
    label();
  });
</script>

<style>
  header.site,
  footer.site {
    display: flex;
    gap: calc(var(--space) * 6);
    align-items: baseline;
    padding-block: calc(var(--space) * 6);
  }
  .home {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: var(--fs-h3);
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    margin-inline-start: auto;
    display: flex;
    gap: calc(var(--space) * 5);
    align-items: baseline;
    font-size: var(--fs-small);
  }
  .theme {
    font: inherit;
    color: var(--signal);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  .theme:hover { text-decoration-thickness: 2px; }
  footer.site {
    margin-block-start: calc(var(--space) * 20);
    border-block-start: 1px solid var(--shoal);
    font-size: var(--fs-small);
    flex-wrap: wrap;
  }
  footer.site span { margin-inline-end: auto; }
  /* Its own line: a request to the reader, not one more profile */
  .support { flex-basis: 100%; }
</style>

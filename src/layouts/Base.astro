---
import '../styles/global.css';
import { SITE, STRINGS, type Locale } from '../site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** The same page in the other language, when it exists */
  alternate?: { lang: Locale; href: string };
  type?: 'website' | 'article';
  /** The launch image Shipcast renders, a site path; shown when the page is shared */
  image?: string;
  /** The index carries the author's name as its masthead, so the header leaves it out */
  home?: boolean;
}

const { lang, title, description, alternate, type = 'website', image, home = false } = Astro.props;
const t = STRINGS[lang];
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The home page is the author's own; every other page says what it is, then whose site it is
const pageTitle = title === t.title ? SITE.author : `${title} | ${SITE.author}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={t.title} href={`${base}${lang}/rss.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.author} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {
      image && (
        <>
          <meta property="og:image" content={new URL(image, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#000000" />
    <!-- Before the first paint, so a reader who chose day never sees a flash of night -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'day') document.documentElement.dataset.theme = 'day';
    </script>
    {
      // Only the published site counts visits: a dev server or a preview would pollute the numbers
      import.meta.env.PROD && SITE.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <header class="bar">
      <nav class="left" aria-label={t.home}>
        {home ? <a href={`${base}${lang}/`} aria-current="page">{t.title}</a> : <a class="wordmark serif" href={`${base}${lang}/`}><span class="sw">J</span>osé <span class="sw">G</span>arrido</a>}
        <a href={SITE.github} class="hide-s">GitHub</a>
      </nav>
      <nav class="right">
        {alternate && <a href={alternate.href} hreflang={alternate.lang} lang={alternate.lang} class="muted">{t.readIn}</a>}
        <a href={`${base}${lang}/rss.xml`} class="muted hide-s">RSS</a>
        <button type="button" class="theme" data-to-day={t.toDay} data-to-night={t.toNight} aria-label={t.toDay}>
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="wrap foot">
      <div class="who">
        <a class="serif mark" href={`${base}${lang}/`}><span class="sw">J</span>osé <span class="sw">G</span>arrido</a>
        <p class="muted">{SITE.author}</p>
        {/* Its own line: a request to the reader, not one more profile */}
        {SITE.support && <p><a href={SITE.support}>{t.support}</a></p>}
      </div>
      <ul class="links">
        {SITE.profiles.map(([name, href]) => <li><a href={href} rel="me">{name}</a></li>)}
        <li><a href={`${base}${lang}/rss.xml`} class="muted">RSS</a></li>
        <li><a href={`${base}${lang}/privacy/`} class="muted">{t.privacy}</a></li>
      </ul>
    </footer>
  </body>
</html>

<script>
  const button = document.querySelector<HTMLButtonElement>('button.theme');
  const root = document.documentElement;
  const label = () => {
    if (!button) return;
    button.setAttribute('aria-label', (root.dataset.theme === 'day' ? button.dataset.toNight : button.dataset.toDay) ?? '');
  };
  label();
  button?.addEventListener('click', () => {
    if (root.dataset.theme === 'day') {
      delete root.dataset.theme;
      localStorage.removeItem('theme');
    } else {
      root.dataset.theme = 'day';
      localStorage.setItem('theme', 'day');
    }
    label();
  });
</script>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--space) * 6);
    min-height: 4rem;
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
    border-block-end: 1px solid var(--rule);
  }
  .bar nav { display: flex; align-items: center; gap: calc(var(--space) * 7); font-size: var(--fs-ui); }
  .bar a { text-decoration: none; }
  .bar a:hover { text-decoration: underline; }
  .wordmark { font-size: 1.6rem; line-height: 1; }
  .bar a { white-space: nowrap; }
  @media (max-width: 40rem) { .wordmark { font-size: 1.3rem; } .bar nav { gap: calc(var(--space) * 4); } }
  .theme {
    width: 44px; height: 44px; flex: none;
    display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 22px;
    background: transparent; color: var(--text); cursor: pointer;
  }
  .theme .moon { display: none; }
  :global([data-theme='day']) .theme .sun { display: none; }
  :global([data-theme='day']) .theme .moon { display: block; }
  @media (max-width: 40rem) { .hide-s { display: none; } }

  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: calc(var(--space) * 10);
    margin-block-start: calc(var(--space) * 24);
    padding-block: calc(var(--space) * 14) calc(var(--space) * 16);
    border-block-start: 1px solid var(--rule);
  }
  .who p { margin: calc(var(--space) * 2) 0 0; }
  .mark { font-size: 2rem; text-decoration: none; }
  .links {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(8rem, auto)); column-gap: calc(var(--space) * 12); row-gap: calc(var(--space) * 2.5);
    align-content: start;
  }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>

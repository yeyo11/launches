---
import '../styles/global.css';
import Profiles from '../components/Profiles.astro';
import Umami from '../components/Umami.astro';
import { SITE, STRINGS, pagePath, type Locale } from '../site';
import { breadcrumbs, graph, type JsonLdNode } from '../seo';
// The same files global.css declares, so each preload and its @font-face share one request
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2?url';
// The interface's text font: without a preload it is only found once the inlined CSS is parsed
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** The same page in the other language, when it exists */
  alternate?: { lang: Locale; href: string };
  type?: 'website' | 'article';
  /** The launch image Shipcast renders, a site path; shown when the page is shared */
  image?: string;
  /** The index carries the author's name as its masthead, so the header leaves it out */
  home?: boolean;
  /** Kept out of search results, for pages only a link in an email leads to */
  noindex?: boolean;
  /** What the share image shows; without it, the title */
  imageAlt?: string;
  /** An article's dates and tags, for the article:* Open Graph properties */
  article?: { published: Date; modified: Date; tags: string[] };
  /** The page's own nodes for the JSON-LD graph; the author and the site are always there */
  jsonLd?: JsonLdNode[];
  /** The page as Markdown, a site path, for AI assistants and readers that want the source */
  markdown?: string;
  /** Adds Home › this page to the JSON-LD graph, under this name */
  breadcrumb?: string;
  /** The pages between Home and this one in the breadcrumbs, e.g. Projects on a project's page */
  trail?: Array<{ name: string; href: string }>;
  /** Which section of the navigation this page belongs to, marked as the current one */
  section?: 'projects' | 'articles' | 'about';
}

const { lang, title, description, alternate, type = 'website', image, home = false, noindex = false, imageAlt, article, jsonLd = [], markdown, breadcrumb, trail = [], section } = Astro.props;
const t = STRINGS[lang];
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The home page is the author's own; every other page says what it is, then whose site it is
const pageTitle = title === t.title ? SITE.author : `${title} | ${SITE.author}`;
// A page without a launch image of its own is shared with the site's card, in its language
const shareImage = new URL(image ?? `${base}og-default-${lang}.png`, Astro.site);
const nodes = breadcrumb
  ? [
      ...jsonLd,
      breadcrumbs([
        { name: t.home, url: new URL(`${base}${lang}/`, Astro.site) },
        ...trail.map((crumb) => ({ name: crumb.name, url: new URL(crumb.href, Astro.site) })),
        { name: breadcrumb, url: canonical },
      ]),
    ]
  : jsonLd;
// The site's sections, in the header and the footer alike
const sections = [
  { key: 'projects', href: pagePath('projects', lang), label: t.projects },
  { key: 'articles', href: pagePath('articles', lang), label: t.articles },
  { key: 'about', href: pagePath('about', lang), label: t.about },
] as const;
const ogLocale = (l: Locale) => (l === 'es' ? 'es_ES' : 'en_US');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {/* Every page opens with Fraunces, upright and in the italic of each headline initial (the
        masthead, a headline, an article's summary); fetching both with the HTML instead of after the
        CSS is what keeps the swap before the first paint. Measured: without them the article's
        summary reflows (CLS 0.09) and the first paint comes 1.5 s later on a mobile profile */}
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      // Every language version lists itself, the other one, and English as the default for everyone else
      alternate && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : new URL(alternate.href, Astro.site)} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={t.title} href={`${base}${lang}/rss.xml`} />
    {markdown && <link rel="alternate" type="text/markdown" title={title} href={markdown} />}
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {/* Google's results want a square raster icon, a multiple of 48 px */}
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}favicon-48.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.author} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {alternate && <meta property="og:locale:alternate" content={ogLocale(alternate.lang)} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={article.modified.toISOString()} />
          <meta property="article:author" content={new URL(pagePath('about', lang), Astro.site)} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <script type="application/ld+json" set:html={graph(nodes)} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#000000" />
    <!-- Before the first paint, so a reader who chose day never sees a flash of night, and so the
         styles that wait for a script (the tabs of a project's page) know one will run -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('theme') === 'day') document.documentElement.dataset.theme = 'day';
    </script>
    {
      // Only the published site counts visits: a dev server or a preview would pollute the numbers
      import.meta.env.PROD && SITE.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.analyticsToken })}
        />
      )
    }
    {/* Umami, next to the beacon, once UMAMI_SCRIPT_URL and UMAMI_WEBSITE_ID are set at build time */}
    {import.meta.env.PROD && SITE.umami && <Umami umami={SITE.umami} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="bar">
      {home ? <a class="home" href={`${base}${lang}/`} aria-current="page">{t.title}</a> : <a class="wordmark serif" href={`${base}${lang}/`}><span class="sw">J</span>osé <span class="sw">G</span>arrido</a>}
      <nav class="sections" aria-label={t.sections}>
        {sections.map((s) => <a href={s.href} aria-current={section === s.key ? 'page' : undefined}>{s.label}</a>)}
        <a href={SITE.github} class="hide-s">GitHub</a>
      </nav>
      <div class="right">
        {alternate && <a href={alternate.href} hreflang={alternate.lang} lang={alternate.lang} class="muted" data-set-lang={alternate.lang} aria-label={t.readIn}><span class="long">{t.readIn}</span><span class="short">{alternate.lang.toUpperCase()}</span></a>}
        <button type="button" class="theme" data-to-day={t.toDay} data-to-night={t.toNight} aria-label={t.toDay}>
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="wrap foot">
      <div class="who">
        <a class="serif mark" href={`${base}${lang}/`}><span class="sw">J</span>osé <span class="sw">G</span>arrido</a>
        <p class="muted">{SITE.author}</p>
        {/* Its own line: a request to the reader, not one more profile */}
        {SITE.support && <p><a href={SITE.support}>{t.support}</a></p>}
      </div>
      <div class="elsewhere">
        <Profiles />
        <p class="links">
          {sections.map((s) => <a href={s.href} class="muted">{s.label}</a>)}
          <a href={`${base}${lang}/rss.xml`} class="muted">RSS</a>
          <a href={pagePath('privacy', lang)} class="muted">{t.privacy}</a>
        </p>
      </div>
      {/* The year of the build: the site is rebuilt on every launch, so it stays current */}
      <p class="legal muted">© {new Date().getFullYear()} {SITE.author}</p>
    </footer>
  </body>
</html>

<script>
  // A reader who switches language is remembered, so the bare domain opens in it next time (the
  // Worker in worker/index.ts and the fallback in pages/index.astro read this cookie)
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-set-lang]')) {
    link.addEventListener('click', () => {
      document.cookie = `lang=${link.dataset.setLang}; path=/; max-age=31536000; samesite=lax; secure`;
    });
  }

  const button = document.querySelector<HTMLButtonElement>('button.theme');
  const root = document.documentElement;
  const label = () => {
    if (!button) return;
    button.setAttribute('aria-label', (root.dataset.theme === 'day' ? button.dataset.toNight : button.dataset.toDay) ?? '');
  };
  label();
  button?.addEventListener('click', () => {
    if (root.dataset.theme === 'day') {
      delete root.dataset.theme;
      localStorage.removeItem('theme');
    } else {
      root.dataset.theme = 'day';
      localStorage.setItem('theme', 'day');
    }
    label();
  });
</script>

<style>
  /* Off screen until a keyboard reaches it: the first stop of the page */
  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 10;
    padding: 0.75rem 1.1rem; border-radius: 999px;
    background: var(--text); color: var(--ground); font-weight: 600; text-decoration: none;
  }
  .skip:focus { top: 0.75rem; }
  main:focus { outline: none; }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--space) * 6);
    min-height: 4rem;
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
    border-block-end: 1px solid var(--rule);
  }
  .bar nav, .bar .right { display: flex; align-items: center; gap: calc(var(--space) * 7); font-size: var(--fs-ui); }
  .bar .sections { margin-inline-end: auto; }
  .bar a { text-decoration: none; white-space: nowrap; }
  .bar a:hover, .bar a[aria-current='page'] { text-decoration: underline; }
  .bar .sections a[aria-current='page'] { text-decoration-thickness: 2px; text-underline-offset: 0.4em; }
  .wordmark { font-size: 1.6rem; line-height: 1; }
  /* On a phone the sections drop to a row of their own under the wordmark, so nothing overflows at 320 px */
  @media (max-width: 48rem) {
    .bar { flex-wrap: wrap; column-gap: calc(var(--space) * 4); row-gap: 0; padding-block-start: calc(var(--space) * 2); }
    .wordmark { font-size: 1.3rem; }
    .bar .right { gap: calc(var(--space) * 4); }
    .bar .sections { order: 3; flex-basis: 100%; gap: calc(var(--space) * 6); min-height: 2.75rem; border-block-start: 1px solid var(--rule); }
  }
  .theme {
    width: 44px; height: 44px; flex: none;
    display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 22px;
    background: transparent; color: var(--text); cursor: pointer;
  }
  .theme .moon { display: none; }
  :global([data-theme='day']) .theme .sun { display: none; }
  :global([data-theme='day']) .theme .moon { display: block; }
  @media (max-width: 48rem) { .hide-s { display: none; } }
  /* At 320 px the wordmark, the language and the theme only share one line with the language as its code */
  .short { display: none; }
  @media (max-width: 24rem) { .long { display: none; } .short { display: inline; } }

  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: calc(var(--space) * 10);
    margin-block-start: calc(var(--space) * 24);
    padding-block: calc(var(--space) * 14) calc(var(--space) * 6);
    border-block-start: 1px solid var(--rule);
  }
  .who p { margin: calc(var(--space) * 2) 0 0; }
  .mark { font-size: 2rem; text-decoration: none; }
  .elsewhere { display: flex; flex-direction: column; gap: calc(var(--space) * 5); }
  /* The page's last line: centred under everything, close to the bottom edge */
  .legal { flex-basis: 100%; margin: calc(var(--space) * 4) 0 0; padding-block-start: calc(var(--space) * 6); border-block-start: 1px solid var(--rule); font-size: var(--fs-meta); text-align: center; }
  .links { margin: 0; display: flex; flex-wrap: wrap; gap: calc(var(--space) * 6); font-size: var(--fs-meta); }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>

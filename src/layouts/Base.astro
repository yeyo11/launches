---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { SITE, STRINGS, type Locale } from '../site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** The same page in the other language, when it exists */
  alternate?: { lang: Locale; href: string };
  type?: 'website' | 'article';
  /** The index carries the author's name as its h1, so the header shows only the mark */
  home?: boolean;
}

const { lang, title, description, alternate, type = 'website', home = false } = Astro.props;
const t = STRINGS[lang];
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The home page is the author's own; every other page says what it is, then whose site it is
const pageTitle = title === t.title ? SITE.author : `${title} | ${SITE.author}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={t.title} href={`${base}${lang}/rss.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#17211D" />
    <!-- Before the first paint, so a reader who chose day never sees a flash of night -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'day') document.documentElement.dataset.theme = 'day';
    </script>
    {
      // Only the published site counts visits: a dev server or a preview would pollute the numbers
      import.meta.env.PROD && SITE.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <header class="site wrap ui">
      <a class="home" href={`${base}${lang}/`} aria-label={home ? t.home : undefined}>
        <Mark size={34} />
        {!home && <span>{SITE.author}</span>}
      </a>
      <nav>
        {alternate && <a href={alternate.href} hreflang={alternate.lang} lang={alternate.lang}>{t.readIn}</a>}
        <button type="button" class="theme" data-to-day={t.toDay} data-to-night={t.toNight}>{t.toDay}</button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site wrap ui muted">
      <p class="who">{SITE.author}</p>
      <p>{SITE.profiles.map(([name, href]) => <a href={href} rel="me">{name}</a>)}</p>
      <p>
        <a href={`${base}${lang}/rss.xml`}>RSS</a>
        <a href={`${base}${lang}/privacy/`}>{t.privacy}</a>
      </p>
      {/* Its own line: a request to the reader, not one more profile */}
      {SITE.support && <p><a href={SITE.support}>{t.support}</a></p>}
    </footer>
  </body>
</html>

<script>
  const button = document.querySelector<HTMLButtonElement>('button.theme');
  const root = document.documentElement;
  const label = () => {
    if (!button) return;
    button.textContent = (root.dataset.theme === 'day' ? button.dataset.toNight : button.dataset.toDay) ?? '';
  };
  label();
  button?.addEventListener('click', () => {
    if (root.dataset.theme === 'day') {
      delete root.dataset.theme;
      localStorage.removeItem('theme');
    } else {
      root.dataset.theme = 'day';
      localStorage.setItem('theme', 'day');
    }
    label();
  });
</script>

<style>
  header.site,
  footer.site {
    display: flex;
    gap: calc(var(--space) * 6);
    align-items: center;
    padding-block: calc(var(--space) * 6);
  }
  .home {
    display: flex;
    align-items: center;
    gap: calc(var(--space) * 3);
    color: var(--chalk);
    text-decoration: none;
    font-weight: 650;
    font-size: var(--fs-small);
  }
  .home:hover span { text-decoration: underline; text-decoration-color: var(--accent); }
  .home :global(.mark) { flex: none; }
  /* On a phone the mark alone leads home; the name stays for screen readers */
  @media (max-width: 30rem) {
    .home span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  nav {
    margin-inline-start: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: calc(var(--space) * 5);
    row-gap: calc(var(--space) * 1);
    align-items: baseline;
    font-size: var(--fs-small);
  }
  /* The frame's links are quiet: chalk with a rule-coloured underline, so yellow stays for links
     inside the text, focus and the mark */
  nav a,
  footer.site a,
  .theme {
    color: inherit;
    text-decoration-color: var(--rule);
  }
  nav a:hover,
  footer.site a:hover,
  .theme:hover { text-decoration-color: var(--accent); }
  nav { color: var(--chalk); }
  .theme {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-underline-offset: 0.2em;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
  }
  footer.site {
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--space) * 3);
    margin-block-start: calc(var(--space) * 24);
    padding-block: calc(var(--space) * 8);
    border-block-start: 1px solid var(--tray);
    font-size: var(--fs-small);
  }
  footer.site p { display: flex; flex-wrap: wrap; column-gap: calc(var(--space) * 5); row-gap: calc(var(--space) * 1); margin: 0; }
  .who { color: var(--chalk); font-weight: 650; }
</style>

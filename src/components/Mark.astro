---
// The monogram: a lowercase "jg" in chalk strokes, the g's tail running on as the yellow underline.
// Inline, so the strokes follow the theme; public/favicon.svg and public/avatar.svg are the same
// drawing on the board colour, for places that cannot inherit it.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg class="mark" viewBox="4 4 56 56" width={size} height={size} aria-hidden="true" focusable="false">
  <g transform="translate(1 -3)" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="6">
    <path d="M23 26v17c0 5-3 8-8 8" stroke="currentColor" />
    <circle cx="38" cy="31" r="8" stroke="currentColor" />
    <path d="M46 23v19" stroke="currentColor" />
    <path d="M46 42c0 10-9 15-35 16" stroke="var(--stroke)" />
  </g>
  <circle cx="24" cy="12" r="3.6" fill="currentColor" />
</svg>

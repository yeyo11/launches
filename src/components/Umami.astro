---
// Umami's tracker and the site's own events (named and described in README.md, Analytics). Rendered by
// Base.astro only on a production build with Umami configured (src/umami.mjs), so without it neither
// script reaches the page. Neither draws anything, and the tracker is only fetched once the page has
// loaded and the browser is idle: its start-up (about 100 ms on Lighthouse's mobile profile) never
// competes with the page's own.
import type { Umami } from '../umami.mjs';

interface Props {
  umami: Umami;
}

const { umami } = Astro.props;
// Only the published site counts: a pull request's preview (workers.dev) or Lighthouse on localhost
// load the tracker but send nothing
const domain = new URL(Astro.site ?? 'https://josegarrido.dev').hostname;
---

{/* The tracker's script tag, written by the script below with these attributes; data-performance has it send
    each page view's Web Vitals (LCP, INP, CLS, FCP, TTFB) from real readers */}
<meta name="umami" content={umami.src} data-website-id={umami.websiteId} data-domains={domain} data-host-url={umami.hostUrl} data-performance="true" />

<script>
  type Data = Record<string, string | number>;
  type Tracker = { track: (name: string, data?: Data) => unknown };
  const tracker = () => (window as Window & { umami?: Tracker }).umami;

  // An event sent before the tracker is ready waits for it; a blocked tracker drops them
  const waiting: Array<[string, Data]> = [];
  const track = (name: string, data: Data) => {
    const umami = tracker();
    if (umami) umami.track(name, data);
    else if (waiting.length < 20) waiting.push([name, data]);
  };

  const isArticle = document.querySelector('meta[property="og:type"]')?.getAttribute('content') === 'article';

  // The tracker reads its settings from its own script tag's data-* attributes. An article's page
  // views and events carry Umami's tag `article`, so any report can be narrowed to the articles.
  const config = document.querySelector<HTMLMetaElement>('meta[name="umami"]');
  const start = () => {
    if (!config) return;
    const script = document.createElement('script');
    script.src = config.content;
    for (const [key, value] of Object.entries(config.dataset)) if (value) script.dataset[key] = value;
    if (isArticle) script.dataset.tag = 'article';
    script.addEventListener('load', () => {
      for (const [name, data] of waiting.splice(0)) tracker()?.track(name, data);
    });
    document.head.append(script);
  };
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 3000 }) : setTimeout(start, 1));
  if (document.readyState === 'complete') idle();
  else window.addEventListener('load', idle, { once: true });

  // newsletter-signup: a subscribe form's success (Subscribe.astro announces it)
  document.addEventListener('newsletter-signup', (event) => {
    const form = event.target as HTMLFormElement;
    track('newsletter-signup', { lang: document.documentElement.lang, form: form.dataset.tone ?? '' });
  });

  // newsletter-view: a subscribe form at least half on screen, once per form and page view, so the
  // signups can be read against the readers who saw the form
  if ('IntersectionObserver' in window) {
    const seen = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        seen.unobserve(entry.target);
        const form = entry.target as HTMLFormElement;
        track('newsletter-view', { lang: document.documentElement.lang, form: form.dataset.tone ?? '' });
      }
    }, { threshold: 0.5 });
    for (const form of document.querySelectorAll('form[data-subscribe]')) seen.observe(form);
  }

  // Where on the page a link is: the site's header or footer, an article's text (`article-body`) or the
  // rest of its page, such as its source link (`article`), or another page's content (`page`)
  const placementOf = (link: Element) => {
    if (link.closest('body > header')) return 'header';
    if (link.closest('body > footer')) return 'footer';
    if (isArticle && link.closest('.prose')) return 'article-body';
    if (isArticle) return 'article';
    return 'page';
  };

  // newsletter-confirmed: the page the double opt-in's confirmation link lands on (SubscribedPage.astro)
  if (document.querySelector('[data-newsletter-confirmed]')) track('newsletter-confirmed', { lang: document.documentElement.lang });

  // copy-command: text copied from a code block (a command, a config), with its first line
  document.addEventListener('copy', () => {
    const selection = document.getSelection();
    const node = selection?.anchorNode;
    const element = node instanceof Element ? node : node?.parentElement;
    if (!selection || !element?.closest('pre, code')) return;
    const line = selection.toString().trim().split('\n')[0]?.trim().slice(0, 80);
    if (line) track('copy-command', { text: line });
  });

  // engaged-read: on an article, once the reader has passed 75 % of the page and had it on screen for
  // 60 s, in either order; sent once per page view
  let scrolledDeep = false;
  let readLong = false;
  let engaged = false;
  const checkEngaged = () => {
    if (engaged || !isArticle || !scrolledDeep || !readLong) return;
    engaged = true;
    track('engaged-read', { lang: document.documentElement.lang });
  };

  // github-click: any link to github.com, wherever it is (header, footer, an article's body), opened
  // with a click, the keyboard or the middle button
  const onLink = (event: MouseEvent) => {
    if (event.type === 'auxclick' && event.button !== 1) return;
    const link = (event.target as Element | null)?.closest?.('a[href]');
    if (!(link instanceof HTMLAnchorElement)) return;
    const host = link.hostname.toLowerCase();
    if (host !== 'github.com' && !host.endsWith('.github.com')) return;
    track('github-click', { url: `${link.origin}${link.pathname}`, placement: placementOf(link) });
  };
  document.addEventListener('click', onLink, { capture: true });
  document.addEventListener('auxclick', onLink, { capture: true });

  // scroll-depth: 25, 50, 75 and 100 % of the page, each sent once per page view; measured at most
  // once a frame, and reaching a mark sends the ones below it that were skipped
  const marks = [25, 50, 75, 100];
  let sent = 0;
  let pending = false;
  const measure = () => {
    pending = false;
    const root = document.documentElement;
    const seen = ((window.scrollY + window.innerHeight) / root.scrollHeight) * 100;
    while (sent < marks.length && seen >= marks[sent]! - (marks[sent] === 100 ? 1 : 0)) {
      const depth = marks[sent++]!;
      track('scroll-depth', { depth });
      if (depth >= 75) scrolledDeep = true;
    }
    checkEngaged();
    if (sent === marks.length) window.removeEventListener('scroll', onScroll);
  };
  const onScroll = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(measure);
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // reading-time: on an article, each mark of time on screen (a hidden tab does not count) is sent
  // once, while the reader is still there: Umami's tracker gets no request out while the page unloads,
  // so a total sent on leaving would be lost. One timer at a time, for the next mark only, paused
  // while the tab is hidden.
  if (isArticle) {
    const MARKS = [15, 30, 60, 120, 300, 600];
    let next = 0;
    let shown = 0;
    let visibleSince = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const schedule = () => {
      if (next < MARKS.length) timer = setTimeout(reach, MARKS[next]! * 1000 - shown);
    };
    const reach = () => {
      shown = MARKS[next]! * 1000;
      visibleSince = performance.now();
      const seconds = MARKS[next++]!;
      track('reading-time', { seconds });
      if (seconds >= 60) {
        readLong = true;
        checkEngaged();
      }
      schedule();
    };
    const onVisibility = () => {
      clearTimeout(timer);
      if (document.visibilityState === 'visible') {
        visibleSince = performance.now();
        schedule();
      } else if (visibleSince) {
        shown += performance.now() - visibleSince;
        visibleSince = 0;
      }
    };
    document.addEventListener('visibilitychange', onVisibility);
    if (document.visibilityState === 'visible') onVisibility();
  }
</script>

---
// Who the author is, at /en/about/ and /es/sobre-mi/. Built from the owner's own profile: their words,
// their stack, their quote (kept in English in both languages, as they wrote it).
import Base from '../../layouts/Base.astro';
import Headline from '../Headline.astro';
import Subscribe from '../Subscribe.astro';
import * as simpleIcons from 'simple-icons';
import { SITE, pagePath, type Locale } from '../../site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const other: Locale = lang === 'en' ? 'es' : 'en';
const base = import.meta.env.BASE_URL;
const EMAIL = 'me@josegarrido.dev';

// Logos from Simple Icons (CC0), drawn in the text colour; a tool without one shows its name alone
const STACK: Array<{ en: string; es: string; items: Array<[string, string?]> }> = [
  { en: 'Frontend', es: 'Frontend', items: [['React', 'react'], ['TanStack', 'tanstack'], ['Tailwind', 'tailwindcss'], ['MUI', 'mui'], ['shadcn/ui', 'shadcnui']] },
  { en: 'Backend', es: 'Backend', items: [['TypeScript', 'typescript'], ['Node.js', 'nodedotjs'], ['NestJS', 'nestjs'], ['Fastify', 'fastify'], ['Express', 'express'], ['PostgreSQL', 'postgresql'], ['MongoDB', 'mongodb'], ['Redis', 'redis'], ['MQTT', 'mqtt'], ['BullMQ']] },
  { en: 'Infrastructure', es: 'Infraestructura', items: [['Docker', 'docker'], ['Kubernetes', 'kubernetes'], ['GitLab CI', 'gitlab'], ['Jest', 'jest'], ['Playwright']] },
  { en: 'AI', es: 'IA', items: [['Claude', 'claude'], ['MCP', 'modelcontextprotocol'], ['RAG'], ['Agents']] },
];
const icons = Object.values(simpleIcons) as Array<{ slug: string; path: string }>;
const pathOf = (slug?: string) => (slug ? icons.find((i) => i.slug === slug)?.path : undefined);

const COPY = {
  en: {
    title: 'About me',
    description: 'José Antonio Garrido, full-stack developer. The open-source tools I build, and who is behind them.',
    hello: "Hi, I'm José.",
    lead: 'Full-stack developer. I spend my days between TypeScript, APIs and the terminal, and this is where I share the tools I build.',
    hereTitle: "What's here",
    here: [
      'Every time I finish an open-source tool, I write about it here: what it solves, how to try it and what it still lacks.',
      'Right now that means <a href="https://github.com/yeyo11/claudio">claudio</a>, Claude Code as a service, and <a href="https://github.com/yeyo11/shipcast">Shipcast</a>, which is what publishes these posts.',
    ],
    meTitle: 'About me',
    me: [
      "I've spent years working across the whole stack: APIs, frontends, microservices, real-time data and, lately, a lot of AI. I like clean code, well thought-out architecture, and breaking things to understand how they work.",
    ],
    stackTitle: 'What I work with',
    facts: [
      'I live happily in TypeScript.',
      'The Linux terminal is probably my best friend.',
      "Sometimes I build things that shouldn't work, just to see if they do.",
    ],
    contactTitle: 'Get in touch',
    contact: `The quickest way is an email to <a href="mailto:${EMAIL}">${EMAIL}</a>. I'm also on:`,
  },
  es: {
    title: 'Sobre mí',
    description: 'José Antonio Garrido, desarrollador full-stack. Las herramientas open source que construyo, y quién hay detrás.',
    hello: 'Hola, soy José.',
    lead: 'Desarrollador full-stack. Me paso el día entre TypeScript, APIs y el terminal, y aquí comparto las herramientas que voy construyendo.',
    hereTitle: 'Qué hay aquí',
    here: [
      'Cada vez que termino una herramienta open source, la cuento aquí: qué resuelve, cómo probarla y qué le falta todavía.',
      'Ahora mismo, <a href="https://github.com/yeyo11/claudio">claudio</a>, Claude Code como servicio, y <a href="https://github.com/yeyo11/shipcast">Shipcast</a>, que es quien publica estos posts.',
    ],
    meTitle: 'Sobre mí',
    me: [
      'Llevo años trabajando en todo el stack: APIs, frontends, microservicios, datos en tiempo real y, últimamente, mucha IA. Me gusta el código limpio, la arquitectura bien pensada y romper cosas para entender cómo funcionan.',
    ],
    stackTitle: 'Con qué trabajo',
    facts: [
      'Vivo feliz en TypeScript.',
      'El terminal de Linux es, probablemente, mi mejor amigo.',
      'A veces construyo cosas que no deberían funcionar, solo para ver si funcionan.',
    ],
    contactTitle: 'Escríbeme',
    contact: `Lo más rápido es un correo a <a href="mailto:${EMAIL}">${EMAIL}</a>. También estoy en:`,
  },
}[lang];
---

<Base lang={lang} title={COPY.title} description={COPY.description} alternate={{ lang: other, href: pagePath('about', other) }}>
  <section class="wrap about">
    <header class="intro">
      <img class="photo" src={`${base}author.jpg`} alt={SITE.author} width="220" height="220" />
      <div>
        <Headline as="h1" text={COPY.hello} class="h-about" />
        <p class="lead serif">{COPY.lead}</p>
      </div>
    </header>

    <div class="prose body">
      <h2>{COPY.hereTitle}</h2>
      {COPY.here.map((p) => <p set:html={p} />)}

      <h2>{COPY.meTitle}</h2>
      {COPY.me.map((p) => <p>{p}</p>)}
      <ul>{COPY.facts.map((f) => <li>{f}</li>)}</ul>
    </div>

    <section class="stack" aria-labelledby="stack">
      <h2 id="stack">{COPY.stackTitle}</h2>
      <dl>
        {STACK.map((group) => (
          <div>
            <dt class="meta">{group[lang]}</dt>
            <dd>
              {group.items.map(([name, slug]) => {
                const d = pathOf(slug);
                return (
                  <span class="chip">
                    {d && <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={d} fill="currentColor" /></svg>}
                    {name}
                  </span>
                );
              })}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="prose body">
      <blockquote lang="en">
        <p>Build software like you mean it. Break things to understand them. Repeat.</p>
      </blockquote>

      <h2>{COPY.contactTitle}</h2>
      <p set:html={COPY.contact} />
      <ul class="profiles">
        {SITE.profiles.map(([name, url]) => <li><a href={url} rel="me">{name}</a></li>)}
      </ul>
    </div>

    <div class="signup">
      <Subscribe lang={lang} />
    </div>
  </section>
</Base>

<style>
  .about { padding-block: calc(var(--space) * 14) calc(var(--space) * 20); }
  /* One reading column for the whole page, as an article: the photo, the prose, the stack and the form */
  .about > * { max-width: var(--measure); margin-inline: auto; }
  .intro { display: grid; gap: calc(var(--space) * 8); align-items: center; margin-block-end: calc(var(--space) * 12); }
  @media (min-width: 48rem) { .intro { grid-template-columns: auto 1fr; gap: calc(var(--space) * 12); } }
  .photo { width: 10rem; height: 10rem; border-radius: 50%; object-fit: cover; border: 3px solid var(--text); box-shadow: 8px 8px 0 var(--text); }
  :global(.h-about) { margin: 0; font-size: var(--fs-mast); line-height: 1; }
  .lead { margin: calc(var(--space) * 5) 0 0; font-size: 1.4rem; line-height: 1.5; color: var(--body); max-width: 40rem; }
  .stack { margin-block: calc(var(--space) * 10); }
  .stack h2 { font-family: var(--font-serif); font-weight: 400; font-size: var(--fs-h2); margin: 0 0 calc(var(--space) * 6); }
  .stack dl { margin: 0; display: grid; gap: calc(var(--space) * 5); }
  .stack dt { margin-block-end: calc(var(--space) * 2); }
  .stack dd { margin: 0; display: flex; flex-wrap: wrap; gap: calc(var(--space) * 2); }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.85rem; border: 1.5px solid var(--line); border-radius: 999px; font-size: var(--fs-meta); color: var(--text); }
  .profiles { display: flex; flex-wrap: wrap; gap: calc(var(--space) * 2) calc(var(--space) * 6); list-style: none; padding: 0; }
  /* The prose spaces stacked list items; in a row that would push every link but the first down */
  .profiles li { margin: 0; }
  .signup { border-block-start: 1px solid var(--rule); margin-block-start: calc(var(--space) * 12); padding-block-start: calc(var(--space) * 12); }
</style>
